rules_version = '2';
// 찍!찍!!찍!!! MVP — Firestore 보안 규칙 (Firebase 콘솔 → Firestore → 규칙 에 붙여 넣고 게시). 서버 계획.md 5장.
service cloud.firestore {
  match /databases/{database}/documents {

    // 훈장 기록: 로그인한 사람이 자기 uid 로 새로 쓰기만 (읽기·수정·삭제 불가 — 팀은 콘솔에서 봄)
    match /rankups/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'tier', 'runsTotal', 'runsSinceLast', 'maxFloor', 'playSec',
                                                 'skillNodes', 'shardSum', 'gachaPulls', 'ver', 'build', 'lang', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tier is int && request.resource.data.tier >= 2 && request.resource.data.tier <= 8
        && request.resource.data.runsTotal is int && request.resource.data.runsTotal >= 0 && request.resource.data.runsTotal <= 100000
        && request.resource.data.runsSinceLast is int && request.resource.data.runsSinceLast >= 0 && request.resource.data.runsSinceLast <= 100000
        && request.resource.data.maxFloor is int && request.resource.data.maxFloor >= 1 && request.resource.data.maxFloor <= 1000
        && request.resource.data.playSec is int && request.resource.data.playSec >= 0 && request.resource.data.playSec <= 100000000
        && request.resource.data.skillNodes is int && request.resource.data.skillNodes >= 0 && request.resource.data.skillNodes <= 10000
        && request.resource.data.shardSum is int && request.resource.data.shardSum >= 0 && request.resource.data.shardSum <= 100000
        && request.resource.data.gachaPulls is int && request.resource.data.gachaPulls >= 0 && request.resource.data.gachaPulls <= 1000000
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 32
        && request.resource.data.build is string && request.resource.data.build.size() <= 16
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // 기능 해금 기록 (초반 유저 흐름, 지금: 쳇바퀴 훈련 rats): 로그인한 사람이 자기 uid 로 새로 쓰기만
    match /milestones/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'feature', 'tier', 'runsTotal', 'maxFloor', 'playSec', 'ver', 'build', 'lang', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.feature in ['rats']
        && request.resource.data.tier is int && request.resource.data.tier >= 1 && request.resource.data.tier <= 8
        && request.resource.data.runsTotal is int && request.resource.data.runsTotal >= 0 && request.resource.data.runsTotal <= 100000
        && request.resource.data.maxFloor is int && request.resource.data.maxFloor >= 1 && request.resource.data.maxFloor <= 1000
        && request.resource.data.playSec is int && request.resource.data.playSec >= 0 && request.resource.data.playSec <= 100000000
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 32
        && request.resource.data.build is string && request.resource.data.build.size() <= 16
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // 랭킹: 누구나 읽기 (목록은 100개까지) · 본인 문서만 만들기/덮어쓰기 · 최고 층·훈장은 줄어들 수 없음 · 삭제 불가
    match /players/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'bestFloor', 'bestTier', 'runs', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 12
        && request.resource.data.bestFloor is int && request.resource.data.bestFloor >= 1 && request.resource.data.bestFloor <= 1000
        && request.resource.data.bestTier is int && request.resource.data.bestTier >= 1 && request.resource.data.bestTier <= 8
        && request.resource.data.runs is int && request.resource.data.runs >= 0 && request.resource.data.runs <= 100000
        && request.resource.data.updatedAt == request.time
        && (resource == null || (request.resource.data.bestFloor >= resource.data.bestFloor
                                 && request.resource.data.bestTier >= resource.data.bestTier));
      allow delete: if false;
    }

    // 그 밖 전부 막음
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
