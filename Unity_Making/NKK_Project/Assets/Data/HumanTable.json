   "text": "멈춰! 멈추라고!",
   "text_sk": 3491119
  },
  {
   "line_id": 91120,
   "human_id": 90020,
   "situation": "Panic",
   "text": "차량 통제 중!",
   "text_sk": 3491120
  },
  {
   "line_id": 91121,
   "human_id": 90021,
   "situation": "Panic",
   "text": "커피 타는 중이었는데!",
   "text_sk": 3491121
  },
  {
   "line_id": 91122,
   "human_id": 90021,
   "situation": "Panic",
   "text": "봉지로 젓는 게 국룰인데!",
   "text_sk": 3491122
  },
  {
   "line_id": 91123,
   "human_id": 90022,
   "situation": "Panic",
   "text": "철근 무너진다!",
   "text_sk": 3491123
  },
  {
   "line_id": 91124,
   "human_id": 90022,
   "situation": "Panic",
   "text": "안전모 써!",
   "text_sk": 3491124
  },
  {
   "line_id": 91125,
   "human_id": 90023,
   "situation": "Panic",
   "text": "샘플이 도망간다!",
   "text_sk": 3491125
  },
  {
   "line_id": 91126,
   "human_id": 90023,
   "situation": "Panic",
   "text": "쥐는 해양 생물이 아냐!",
   "text_sk": 3491126
  },
  {
   "line_id": 91127,
   "human_id": 90024,
   "situation": "Panic",
   "text": "꼬르륵… 쥐다!",
   "text_sk": 3491127
  },
  {
   "line_id": 91128,
   "human_id": 90024,
   "situation": "Panic",
   "text": "산소통 물지 마!",
   "text_sk": 3491128
  },
  {
   "line_id": 91129,
   "human_id": 90025,
   "situation": "Panic",
   "text": "묻고 더블로 가!",
   "text_sk": 3491129
  },
  {
   "line_id": 91130,
   "human_id": 90025,
   "situation": "Panic",
   "text": "이 쥐 싯가요!",
   "text_sk": 3491130
  },
  {
   "line_id": 91131,
   "human_id": 90026,
   "situation": "Panic",
   "text": "소금 맛 좀 볼래?!",
   "text_sk": 3491131
  },
  {
   "line_id": 91132,
   "human_id": 90026,
   "situation": "Panic",
   "text": "내 팔꿈치 각도가!",
   "text_sk": 3491132
  },
  {
   "line_id": 91133,
   "human_id": 90027,
   "situation": "Panic",
   "text": "내가 왕년에 말이야!",
   "text_sk": 3491133
  },
  {
   "line_id": 91134,
   "human_id": 90027,
   "situation": "Panic",
   "text": "전시물 만지지 마!",
   "text_sk": 3491134
  },
  {
   "line_id": 91135,
   "human_id": 90028,
   "situation": "Panic",
   "text": "이건 대본에 없었어!",
   "text_sk": 3491135
  },
  {
   "line_id": 91136,
   "human_id": 90028,
   "situation": "Panic",
   "text": "엄폐! 엄폐!",
   "text_sk": 3491136
  },
  {
   "line_id": 91137,
   "human_id": 90029,
   "situation": "Panic",
   "text": "숙제 사진 찍어야 돼!",
   "text_sk": 3491137
  },
  {
   "line_id": 91138,
   "human_id": 90029,
   "situation": "Panic",
   "text": "선생님, 쥐요!!",
   "text_sk": 3491138
  },
  {
   "line_id": 91139,
   "human_id": 90030,
   "situation": "Panic",
   "text": "여기는 박물관, 쥐 출현!",
   "text_sk": 3491139
  },
  {
   "line_id": 91140,
   "human_id": 90030,
   "situation": "Panic",
   "text": "치직… 응답하라!",
   "text_sk": 3491140
  },
  {
   "line_id": 91141,
   "human_id": 90031,
   "situation": "Panic",
   "text": "휴스턴, 문제가 생겼다!",
   "text_sk": 3491141
  },
  {
   "line_id": 91142,
   "human_id": 90031,
   "situation": "Panic",
   "text": "궤도 이탈!",
   "text_sk": 3491142
  },
  {
   "line_id": 91143,
   "human_id": 90032,
   "situation": "Panic",
   "text": "원래 이랬어. (Always has been)",
   "text_sk": 3491143
  },
  {
   "line_id": 91144,
   "human_id": 90032,
   "situation": "Panic",
   "text": "바나나 내려놔!",
   "text_sk": 3491144
  },
  {
   "line_id": 91145,
   "human_id": 90033,
   "situation": "Panic",
   "text": "컷! 컷! 다시 찍어!",
   "text_sk": 3491145
  },
  {
   "line_id": 91146,
   "human_id": 90033,
   "situation": "Panic",
   "text": "조명 넘어진다!",
   "text_sk": 3491146
  },
  {
   "line_id": 91147,
   "human_id": 90034,
   "situation": "Panic",
   "text": "내 커피!!",
   "text_sk": 3491147
  },
  {
   "line_id": 91148,
   "human_id": 90034,
   "situation": "Panic",
   "text": "발사 중지!",
   "text_sk": 3491148
  }
