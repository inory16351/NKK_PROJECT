  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NKK.Lobby.MarketBroker
  body: {fileID: 1534032750}
  idle: {fileID: 21300000, guid: 02c6e300023b1e24cb72f40d52e7715b, type: 3}
  talk: {fileID: 21300000, guid: 3735ef9013f0a81408a1936f936b4c1a, type: 3}
  offer: {fileID: 21300000, guid: 74abc2ab55ae2854f8940f952b1349d7, type: 3}
  cheese: {fileID: 21300000, guid: 9faf2761de0e8ed439d5f9f27cd9e3c3, type: 3}
  bubble: {fileID: 1078101260}
  bubbleText: {fileID: 1979854649}
  greetLocked:
  - "\uC5EC\uAE34 \uC544\uC9C1 \uBB38 \uC548 \uC5F4\uC5C8\uC5B4. 17\uCE35 \uB108\uBA38
    \uC18C\uC2DD\uC774\uB098 \uAC00\uC838\uC640 \uBD10, \uD750\uD750."
  - "\uBB3C\uAC74 \uB4E4\uC5B4\uC624\uB294 \uC911\uC774\uC57C~ \uC880 \uB354 \uB192\uC774
    \uC62C\uB77C\uAC00 \uBCF4\uB77C\uACE0."
  greetOpen:
  - "\uC5B4\uC11C \uC640, \uC950\uC528! \uC624\uB298 \uBB3C\uAC74 \uC88B\uC544~"
  - "\uC27F\u2026 \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uAC13 \uBE7C\uB3CC\uB9B0 \uBB3C\uAC74\uC774\uC57C."
  - "\uCE58\uC988 \uAC00\uC838\uC654\uC5B4? \uD750\uD750."
  idleLines:
  - "\uD750\uD750\u2026 \uCE58\uC988 \uB0C4\uC0C8\uAC00 \uB098\uB294\uAD70."
  - "\uC804\uC124 \uC870\uAC01, \uC2E0\uD654 \uC870\uAC01 \uC788\uC5B4\uC694~"
  - "\uACBD\uBE44\uC6D0 \uC624\uBA74 \uBAA8\uB978 \uCC99\uD558\uB294 \uAC70\uB2E4."
  - "\uC774 \uBBF9\uC11C\uAE30? \uB098\uB3C4 \uBB34\uC11C\uC6CC\uC11C \uC548 \uB4E4\uC5B4\uAC00."
  idleEvery: {x: 7, y: 13}
  bubbleTime: 2.6
  breathe: 0.025
  breatheSpeed: 2.2
  bubblePad: {x: 0.22, y: 0.14}
